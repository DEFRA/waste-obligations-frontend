{
  "name": "waste-obligations-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:integration": "playwright test",
    "test:integration:docker": "INTEGRATION_DIRECT_BASE_URL=http://localhost:3000 INTEGRATION_PROXY_BASE_URL=http://localhost:3001/manage-recycling-obligations playwright test",
    "integration:deps": "docker compose -f compose.integration.yml up -d --wait redis wiremock",
    "integration:up": "AUTH_COOKIE_SECURE=false SESSION_COOKIE_SECURE=false docker compose -f compose.integration.yml up -d --build --wait redis wiremock waste-obligations-frontend waste-obligations-frontend-proxy",
    "integration:ci": "npm run integration:up && npm run test:integration:docker",
    "integration:down": "docker compose -f compose.integration.yml down",
    "integration:install-browsers": "playwright install chromium --with-deps",
    "preintegration:serve": "npm run integration:deps",
    "integration:serve": "NODE_ENV=development AUTH_COOKIE_SECURE=false SESSION_COOKIE_SECURE=false SESSION_CACHE_ENGINE=redis REDIS_HOST=127.0.0.1 REDIS_TLS=false USE_SINGLE_INSTANCE_CACHE=true WASTE_ORGANISATIONS_API_BASE_URL=http://localhost:9080 WASTE_OBLIGATIONS_API_BASE_URL=http://localhost:9080 BACKEND_ACCOUNT_API_BASE_URL=http://localhost:9080/api/ BACKEND_ACCOUNT_API_AUTH_MODE=bearer BACKEND_ACCOUNT_API_OAUTH_TOKEN_ENDPOINT=http://localhost:9080/oauth2/v2.0/token BACKEND_ACCOUNT_API_OAUTH_CLIENT_ID=waste-obligations-frontend BACKEND_ACCOUNT_API_OAUTH_CLIENT_SECRET=test BACKEND_ACCOUNT_API_OAUTH_SCOPE=test node test-helpers/start-integration-server.js",
    "security-audit": "npm audit --audit-level=high",
    "translations:install": "npm --prefix scripts/translations ci",
    "translations:export": "npm --prefix scripts/translations run export --",
    "translations:import": "npm --prefix scripts/translations run import --",
    "test:translations": "npm --prefix scripts/translations test",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "setup:certs": "mkdir -p certs && mkcert -install && mkcert -key-file certs/localhost-key.pem -cert-file certs/localhost-cert.pem localhost 127.0.0.1 ::1",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "imports": {
    "#/*": "./src/*",
    "#/test-helpers/*": "./test-helpers/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/bell": "13.1.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.1",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "7.1.7",
    "cssnano-preset-default": "8.0.0",
    "date-fns": "4.1.0",
    "global-agent": "3.0.0",
    "govuk-frontend": "5.13.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.0",
    "ioredis": "5.10.1",
    "joi": "18.2.1",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.5",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.3",
    "@defra/hapi-connect": "1.0.1",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.4",
    "cheerio": "1.2.0",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.2",
    "sass-embedded": "1.99.0",
    "stylelint": "16.26.1",
    "stylelint-config-gds": "2.0.0",
    "vite": "8.0.16",
    "vitest": "4.1.4",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.24"
  }
}
