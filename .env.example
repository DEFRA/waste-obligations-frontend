PORT=3000
NODE_ENV=development

REDIS_HOST=127.0.0.1
USE_SINGLE_INSTANCE_CACHE=true
REDIS_TLS=false

SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long
# Set to false only when running plain HTTP without TLS (no mkcert / no 8010 proxy)
SESSION_COOKIE_SECURE=true

# Start backends from epr-local-environment first:
#   docker compose --profile obligations up -d
WASTE_ORGANISATIONS_API_BASE_URL=http://localhost:8006
WASTE_ORGANISATIONS_API_AUTH_MODE=basic
WASTE_ORGANISATIONS_API_CLIENT_ID=waste-obligations-frontend
WASTE_ORGANISATIONS_API_CLIENT_SECRET=waste-obligations-frontend-pwd

WASTE_OBLIGATIONS_API_BASE_URL=http://localhost:8007
WASTE_OBLIGATIONS_API_AUTH_MODE=basic
WASTE_OBLIGATIONS_API_CLIENT_ID=waste-obligations-frontend
WASTE_OBLIGATIONS_API_CLIENT_SECRET=waste-obligations-frontend-pwd

# EPR packaging frontend (header, footer, navigation) — local stack on port 7084
EPR_PACKAGING_HOME_URL=https://localhost:7084/report-data
EPR_PACKAGING_MANAGE_ACCOUNT_URL=https://localhost:7084/manage-account
EPR_PACKAGING_SIGN_OUT_URL=https://localhost:7084/sign-out
EPR_PACKAGING_COOKIES_URL=https://localhost:7084/cookies
MANAGE_YOUR_RECYCLING_OBLIGATIONS_URL=https://localhost:7084/report-data/manage-your-recycling-obligations
SERVICE_FEEDBACK_URL=https://defragroup.eu.qualtrics.com/jfe/form/SV_e5HK8ijKACZGi1M
EPR_SUPPORT_EMAIL=eprcustomerservice@defra.gov.uk
EPR_SUPPORT_TELEPHONE=0300 060 0002
EPR_PRIVACY_URL=https://www.gov.uk/guidance/extended-producer-responsibility-for-packaging-privacy-policy
EPR_ACCESSIBILITY_URL=https://www.gov.uk/guidance/extended-producer-responsibility-for-packaging-accessibility-statement

# cdp-waste-obligations-frontend-signin-dev — set secret from Key Vault / app registration
AZURE_AD_B2C_CLIENT_ID=1a512714-ecd4-44f1-ad60-8229da59fb52
AZURE_AD_B2C_CLIENT_SECRET=
AZURE_AD_B2C_INSTANCE=https://AZDCUSPOC2.b2clogin.com
AZURE_AD_B2C_DOMAIN=AZDCUSPOC2.onmicrosoft.com
AZURE_AD_B2C_TENANT_ID=8a3f509a-c892-4bec-bfe9-d5f5cf251813
AZURE_AD_B2C_USER_FLOW=B2C_1A_EPR_SignUpSignIn
AZURE_AD_B2C_REDIRECT_URI=https://localhost:8010/signin-oidc
AZURE_AD_B2C_POST_LOGOUT_REDIRECT_PATH=/signed-out
AUTH_COOKIE_PASSWORD=secret-password-must-be-at-least-32-characters-long
# Set to false only when running plain HTTP without TLS
AUTH_COOKIE_SECURE=true
