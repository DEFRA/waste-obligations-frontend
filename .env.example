PORT=3000
NODE_ENV=development

REDIS_HOST=127.0.0.1
LOCALSTACK_ENDPOINT=http://localhost:4566
USE_SINGLE_INSTANCE_CACHE=true

# Both APIs default to WireMock on host port 9080 (see compose.yml wiremock service).
# For real local backends, set e.g. http://localhost:9090 and http://localhost:8080.
WASTE_ORGANISATIONS_API_BASE_URL=http://localhost:9080
WASTE_ORGANISATIONS_API_AUTH_MODE=basic
WASTE_ORGANISATIONS_API_CLIENT_ID=Developer
WASTE_ORGANISATIONS_API_CLIENT_SECRET=developer-pwd

WASTE_OBLIGATIONS_API_BASE_URL=http://localhost:9080
WASTE_OBLIGATIONS_API_AUTH_MODE=basic
WASTE_OBLIGATIONS_API_CLIENT_ID=Developer
WASTE_OBLIGATIONS_API_CLIENT_SECRET=developer-pwd

MANAGE_YOUR_RECYCLING_OBLIGATIONS_URL=https://localhost:7084/report-data/manage-your-recycling-obligations
