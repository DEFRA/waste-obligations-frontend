{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "waste-obligations-frontend"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <p>This page shows the route and payload changes needed for the certificate & statement journey.</p>
        <p><strong>organisationId:</strong> {{ organisationId or "not provided" }}</p>
        <p><strong>lang:</strong> {{ lang or "not provided" }}</p>
        <p><strong>year:</strong> {{ year or "not provided" }}</p>

        {% if errorMessage %}
          <p class="govuk-error-message">Unable to read API responses: {{ errorMessage }}</p>
        {% endif %}

        <h2 class="govuk-heading-m">Current API calls</h2>
        <h3 class="govuk-heading-s">Waste obligations</h3>
        <pre class="govuk-body">GET /organisations/{{ organisationId }}/obligations?include=organisation&amp;obligationYear={{ year }}</pre>
        <pre class="govuk-body">{{ obligationsResponse | dump(2) }}</pre>

        <h3 class="govuk-heading-s">Compliance declarations</h3>
        <pre class="govuk-body">GET /organisations/{{ organisationId }}/compliance-declarations?obligationYear={{ year }}</pre>
        <pre class="govuk-body">{{ complianceDeclarationsResponse | dump(2) }}</pre>

        <h3 class="govuk-heading-s">Waste organisations</h3>
        <pre class="govuk-body">GET /organisations/{{ organisationId }}</pre>
        <pre class="govuk-body">{{ organisationResponse | dump(2) }}</pre>

        <h2 class="govuk-heading-m">Create declaration payload preview</h2>
        <pre class="govuk-body">POST /organisations/{{ organisationId }}/compliance-declarations</pre>
        <pre class="govuk-body">{{ declarationPayloadPreview | dump(2) }}</pre>

        <h2 class="govuk-heading-m">Create declaration response</h2>
        <p>
          Add <code>createDeclaration=true</code> to trigger the POST integration from this page.
        </p>
        {% if createDeclarationRequested %}
          <pre class="govuk-body">{{ createdComplianceDeclarationResponse | dump(2) }}</pre>
        {% else %}
          <p>Not requested.</p>
        {% endif %}
      </div>
    </div>
  </div>

{% endblock %}
