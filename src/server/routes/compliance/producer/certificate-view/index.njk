{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "certificate-obligations-table/macro.njk" import appCertificateObligationsTable %}
{% from "compliance-submit/declaration-text/macro.njk" import appComplianceSubmitDeclarationText %}

{% set pageLocaleBase = 'compliance.certificateView' %}
{% set declarationLocaleBase = 'compliance.certificateSubmit' %}
{% set p = pageI18n(locale, pageLocaleBase) %}
{% set declaration = pageI18n(locale, declarationLocaleBase) %}
{% set heading = p.t('heading', { year: year }) %}
{% set pageTitle = heading %}

{% block content %}
  <div class="app-certificate">
    {{ appHeading({
      caption: p.ct('page', 'preHeader'),
      captionSize: "xl",
      text: heading,
      headingSize: "xl",
      gridColumnClasses: "govuk-grid-column-full"
    }) }}

    <section class="govuk-grid-row" aria-labelledby="organisation-summary-heading">
      <div class="govuk-grid-column-two-thirds">
        {{ govukSummaryList({
          classes: "govuk-!-margin-bottom-0",
          rows: [
            {
              key: { text: p.ct('summaryList', 'organisationName'), attributes: { id: "organisation-summary-heading" } },
              value: { text: organisationName }
            },
            {
              key: { text: p.ct('summaryList', 'organisationId') },
              value: { text: organisationNumber }
            },
            {
              key: { text: p.ct('summaryList', 'address') },
              value: { text: organisationAddress }
            },
            {
              key: { text: p.ct('summaryList', 'nameOnAccount') },
              value: { text: nameOnAccount }
            },
            {
              key: { text: p.ct('summaryList', 'submissionDate') },
              value: { text: submissionDate }
            },
            {
              key: { text: p.ct('summaryList', 'regulator') },
              value: { text: regulatorName }
            }
          ]
        }) }}
      </div>
    </section>

    <section class="govuk-grid-row" aria-labelledby="overall-status-heading">
      <div class="govuk-grid-column-full">
        <h2 id="overall-status-heading" class="govuk-heading-l">{{ p.ct('overallStatus', 'recyclingObligationsStatusHeading') }}</h2>
        {% if obligationStatus == 'Met' %}
          <div class="app-obligation-status app-obligation-status--met govuk-!-margin-bottom-6" role="status">
            <p class="app-obligation-status__text govuk-body-l govuk-!-font-weight-bold">
              {{ p.ct('overallStatus', 'overallMet') }}
            </p>
          </div>
        {% else %}
          <div class="app-obligation-status app-obligation-status--not-met govuk-!-margin-bottom-6" role="status">
            <p class="app-obligation-status__text govuk-body-l govuk-!-font-weight-bold">
              {{ p.ct('overallStatus', 'overallNotMet') }}
            </p>
          </div>
        {% endif %}
      </div>
    </section>

    <section class="govuk-grid-row" aria-labelledby="obligations-table-heading">
      <div class="govuk-grid-column-full">
        <h2 id="obligations-table-heading" class="govuk-heading-l">{{ p.ct('obligationsTable', 'recyclingObligationsHeading') }}</h2>
        <p id="obligations-tonnes-note" class="govuk-body govuk-!-margin-bottom-4">{{ p.ct('obligationsTable', 'tonnesNote') }}</p>

        {{ appCertificateObligationsTable({
          locale: locale,
          i18n: p,
          tableRows: obligationsTableRows,
          ariaLabelledBy: "obligations-table-heading",
          attributes: { "aria-describedby": "obligations-tonnes-note" }
        }) }}
      </div>
    </section>

    <section class="govuk-grid-row" aria-labelledby="glass-table-heading">
      <div class="govuk-grid-column-full">
        <h2 id="glass-table-heading" class="govuk-heading-m">{{ p.ct('obligationsTable', 'glassHeading') }}</h2>

        {{ appCertificateObligationsTable({
          locale: locale,
          i18n: p,
          tableRows: glassTableRows,
          ariaLabelledBy: "glass-table-heading"
        }) }}
      </div>
    </section>

    <section class="govuk-grid-row" aria-labelledby="declaration-heading">
      <div class="govuk-grid-column-two-thirds">
        <h2 id="declaration-heading" class="govuk-heading-m">{{ declaration.ct('declaration', 'heading') }}</h2>

        {{ appComplianceSubmitDeclarationText({
          i18n: declaration,
          interpolation: { organisationName: organisationName }
        }) }}

        <p class="govuk-body">
          {{ p.ct('page', 'verifiedByPrefix') }}
          <strong>{{ submitterName }}</strong>
        </p>
      </div>
    </section>

    <section class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <div class="govuk-button-group">
          {{ govukButton({
            text: p.ct('page', 'returnButton'),
            href: eprPackaging.manageYourRecyclingObligationsUrl,
            classes: "govuk-button--secondary"
          }) }}
          <span class="govuk-body govuk-!-margin-bottom-0">
            <a class="govuk-link govuk-link--disabled" aria-disabled="true" tabindex="-1">{{ p.ct('page', 'downloadLink') }}</a>
          </span>
        </div>
      </div>
    </section>
  </div>
{% endblock %}
