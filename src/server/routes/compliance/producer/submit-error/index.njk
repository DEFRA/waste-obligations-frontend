{% extends 'layouts/page.njk' %}

{% from "component-locale/macro.njk" import componentT %}

{% set localeBase = 'compliance.submitError' %}
{% set heading = t(locale, localeBase + ".heading") %}
{% set pageTitle = heading %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">{{ componentT(locale, localeBase, complianceType, 'body1') }}</p>
      <p class="govuk-body">{{ componentT(locale, localeBase, complianceType, 'body2') }}</p>
      <p class="govuk-body">
        {{ componentT(locale, localeBase, 'homepage', 'prefix') }}
        <a class="govuk-link" href="{{ eprPackaging.homeUrl }}">{{ componentT(locale, localeBase, 'homepage', 'linkText') }}</a>.
      </p>
    </div>
  </div>
{% endblock %}
