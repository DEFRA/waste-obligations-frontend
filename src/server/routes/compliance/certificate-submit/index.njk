{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "obligation-status-tag/macro.njk" import appObligationStatusTag %}

{% set pageTitle = t(locale, "compliance.certificateSubmit.pageTitle") %}
{% set heading = t(locale, "compliance.certificateSubmit.heading", { year: year }) %}

{% block content %}
  <div class="app-certificate-submit">
  {{ appHeading({
    text: heading,
    gridColumnClasses: 'govuk-grid-column-full'
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% call govukInsetText({}) %}
        <p class="govuk-body">
          {{ t(locale, "compliance.certificateSubmit.insetLead", { regulatorName: regulatorName }) }}
          <a class="govuk-link" href="mailto:{{ regulatorEmail }}">{{ regulatorEmail }}</a>.
        </p>
      {% endcall %}
    </div>
  </div>

  <section class="govuk-grid-row" aria-labelledby="organisation-details-heading">
    <div class="govuk-grid-column-two-thirds">
      <h2 id="organisation-details-heading" class="govuk-visually-hidden">{{ t(locale, "compliance.accessibility.organisationDetailsHeading") }}</h2>
      <dl class="govuk-summary-list govuk-!-margin-bottom-0">
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(locale, "compliance.certificateSubmit.summaryOrganisationName") }}</dt>
          <dd class="govuk-summary-list__value">{{ organisationName }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(locale, "compliance.certificateSubmit.summaryOrganisationId") }}</dt>
          <dd class="govuk-summary-list__value">{{ organisationNumber }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(locale, "compliance.certificateSubmit.summaryAddress") }}</dt>
          <dd class="govuk-summary-list__value">{{ organisationAddress }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(locale, "compliance.certificateSubmit.summaryNameOnAccount") }}</dt>
          <dd class="govuk-summary-list__value">{{ fullName }}</dd>
        </div>
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ t(locale, "compliance.certificateSubmit.summaryRegulator") }}</dt>
          <dd class="govuk-summary-list__value">{{ regulatorName }}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="govuk-grid-row" aria-labelledby="overall-status-heading">
    <div class="govuk-grid-column-full">
      <h2 id="overall-status-heading" class="govuk-visually-hidden">{{ t(locale, "compliance.accessibility.overallStatusHeading") }}</h2>
      {% if overallStatus == 'Met' %}
        <div class="app-obligation-status app-obligation-status--met govuk-!-margin-bottom-6" role="status">
          <p class="app-obligation-status__text govuk-body-l govuk-!-font-weight-bold">
            {{ t(locale, "compliance.certificateSubmit.overallMet") }}
          </p>
        </div>
      {% else %}
        <div class="app-obligation-status app-obligation-status--not-met govuk-!-margin-bottom-6" role="status">
          <p class="app-obligation-status__text govuk-body-l govuk-!-font-weight-bold">
            {{ t(locale, "compliance.certificateSubmit.overallNotMet") }}
          </p>
        </div>
      {% endif %}
    </div>
  </section>

  <section class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <p id="obligations-tonnes-note" class="govuk-body govuk-!-margin-bottom-4">{{ t(locale, "compliance.certificateSubmit.tonnesNote") }}</p>

      <table class="govuk-table app-certificate-submit-table govuk-!-margin-bottom-0" aria-describedby="obligations-tonnes-note">
        <caption class="govuk-table__caption govuk-table__caption--m">{{ t(locale, "compliance.accessibility.obligationsTableCaption") }}</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">{{ t(locale, "compliance.certificateSubmit.tableMaterial") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableObligationToMeet") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableAwaiting") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableAccepted") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableOutstanding") }}</th>
            <th scope="col" class="govuk-table__header">{{ t(locale, "compliance.certificateSubmit.tableStatus") }}</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for row in obligationsRows %}
            <tr class="govuk-table__row">
              <th scope="row" class="govuk-table__header">{{ t(locale, row.materialKey, row.materialParams or {}) }}</th>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.obligationToMeet }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.awaitingAcceptance }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.accepted }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.outstanding }}</td>
              <td class="govuk-table__cell">
                {{ appObligationStatusTag(locale, row.tag) }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="govuk-grid-row" aria-labelledby="glass-table-heading">
    <div class="govuk-grid-column-full">
      <h2 id="glass-table-heading" class="govuk-heading-m">{{ t(locale, "compliance.certificateSubmit.glassHeading") }}</h2>

      <table class="govuk-table app-certificate-submit-table govuk-!-margin-bottom-0" aria-labelledby="glass-table-heading">
        <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">{{ t(locale, "compliance.accessibility.glassTableCaption") }}</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">{{ t(locale, "compliance.certificateSubmit.tableMaterial") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableObligationToMeet") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableAwaiting") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableAccepted") }}</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ t(locale, "compliance.certificateSubmit.tableOutstanding") }}</th>
            <th scope="col" class="govuk-table__header">{{ t(locale, "compliance.certificateSubmit.tableStatus") }}</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for row in glassRows %}
            <tr class="govuk-table__row">
              <th scope="row" class="govuk-table__header">{{ t(locale, row.materialKey, row.materialParams or {}) }}</th>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.obligationToMeet }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.awaitingAcceptance }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.accepted }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.outstanding }}</td>
              <td class="govuk-table__cell">
                {{ appObligationStatusTag(locale, row.tag) }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="govuk-grid-row" aria-labelledby="declaration-heading">
    <div class="govuk-grid-column-two-thirds">
      <h2 id="declaration-heading" class="govuk-heading-m">{{ t(locale, "compliance.certificateSubmit.declarationHeading") }}</h2>

      <p class="govuk-body">{{ declarationText.intro }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for bullet in declarationText.bullets %}
          <li>{{ bullet }}</li>
        {% endfor %}
      </ul>

      <form method="post" novalidate>
        {{ govukInput({
          id: "fullName",
          name: "fullName",
          autocomplete: "name",
          label: { text: t(locale, "compliance.certificateSubmit.fullNameLabel") },
          hint: { text: t(locale, "compliance.certificateSubmit.fullNameHint") }
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: t(locale, "compliance.certificateSubmit.submitButton") }) }}
          <a class="govuk-link" href="{{ eprPackaging.manageYourRecyclingObligationsUrl }}">{{ t(locale, "compliance.certificateSubmit.cancelLink") }}</a>
        </div>
      </form>
    </div>
  </section>
  </div>
{% endblock %}
