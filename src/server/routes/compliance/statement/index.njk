{% extends 'layouts/page.njk' %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">
        Your statement of compliance tells the environmental regulator whether, in the past year, you have met the requirements in
        <a class="govuk-link" href="https://www.legislation.gov.uk/uksi/2024/1332/regulation/43" rel="noreferrer noopener" target="_blank">regulation 43</a>
        of the Producer Responsibility Regulations (Packaging and Packaging Waste) Regulations 2024.
      </p>

      <p class="govuk-body">This includes:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>registering producers who are members of your compliance scheme</li>
        <li>reporting their packaging data</li>
        <li>meeting your recycling obligations</li>
      </ul>

      <p class="govuk-body">
        You must submit a statement of compliance whether or not you have complied with the requirements of regulation 43.
      </p>

      <p class="govuk-body">
        You must submit the statement to the environmental regulator before or on 31 January every year.
      </p>

      {{ govukWarningText({
        text: "You may be subject to enforcement action if you do not submit your statement of compliance on time.",
        iconFallbackText: "Warning"
      }) }}

      <h2 class="govuk-heading-l">How to submit your statement</h2>

      <p class="govuk-body">
        You must be an approved or delegated person to submit the statement of compliance.
      </p>

      <p class="govuk-body">
        On the next screen, you will see a copy of your statement for {{ year }}. Before submitting it, you must:
      </p>

      <ul class="govuk-list govuk-list--bullet">
        <li>check the details are correct</li>
        <li>provide your name</li>
      </ul>

      <p class="govuk-body">
        If any details are incorrect, contact your environmental regulator:
        <a class="govuk-link" href="mailto:{{ regulatorEmail }}">{{ regulatorEmail }}</a>.
      </p>

      <p class="govuk-body">
        You will be able to download or print your statement after submission.
      </p>

      {{ govukButton({
        text: "Continue",
        disabled: true
      }) }}
    </div>
  </div>
{% endblock %}

