{% extends 'compliance/compliance-submit.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "compliance-submit/declaration-text/macro.njk" import appComplianceSubmitDeclarationText %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "component-locale/macro.njk" import componentT %}

{% set declarationInterpolation = { complianceSchemeName: complianceSchemeName } %}

{% set organisationSummaryRows = [
  {
    key: { text: componentT(locale, localeBase, 'summaryList', 'complianceScheme'), attributes: { id: "organisation-summary-heading" } },
    value: { text: complianceSchemeName }
  },
  {
    key: { text: componentT(locale, localeBase, 'summaryList', 'schemeOperator') },
    value: { text: schemeOperatorName }
  },
  {
    key: { text: componentT(locale, localeBase, 'summaryList', 'organisationId') },
    value: { text: organisationNumber }
  },
  {
    key: { text: componentT(locale, localeBase, 'summaryList', 'address') },
    value: { text: organisationAddress }
  },
  {
    key: { text: componentT(locale, localeBase, 'summaryList', 'nameOnAccount') },
    value: { text: nameOnAccount }
  },
  {
    key: { text: componentT(locale, localeBase, 'summaryList', 'regulator') },
    value: { text: regulatorName }
  }
] %}

{% block submitFormSection %}
  <h2 id="regulation43-heading" class="govuk-heading-m">{{ componentT(locale, localeBase, 'regulation43', 'heading') }}</h2>

  <form method="post" novalidate>
    <input type="hidden" name="crumb" value="{{ crumb }}">

    {{ govukRadios({
      idPrefix: "regulation43Compliant",
      name: "regulation43Compliant",
      fieldset: {
        legend: {
          html: componentT(locale, localeBase, 'regulation43', 'legendPrefix') + ' <a class="govuk-link" href="' + regulation43Url + '" target="_blank" rel="noopener noreferrer">' + t(locale, "common.regulation43Text") + '<span class="govuk-visually-hidden"> ' + t(locale, "common.opensInNewTab") + '</span></a> ' + componentT(locale, localeBase, 'regulation43', 'legendSuffix'),
          isPageHeading: false
        }
      },
      items: [
        {
          value: "yes",
          text: componentT(locale, localeBase, 'regulation43', 'yes'),
          checked: regulation43Input == "yes"
        },
        {
          value: "no",
          text: componentT(locale, localeBase, 'regulation43', 'no'),
          checked: regulation43Input == "no"
        }
      ],
      errorMessage: { text: formErrors.fields.regulation43Compliant } if formErrors and formErrors.fields.regulation43Compliant
    }) }}

    <h2 class="govuk-heading-m">{{ componentT(locale, localeBase, 'declaration', 'heading') }}</h2>

    {{ appComplianceSubmitDeclarationText({
      locale: locale,
      localeBase: localeBase,
      interpolation: declarationInterpolation
    }) }}

    {{ govukInput({
      id: "fullName",
      name: "fullName",
      value: fullNameInput,
      autocomplete: "name",
      label: { text: componentT(locale, localeBase, 'declaration', 'fullNameLabel') },
      errorMessage: { text: formErrors.fields.fullName } if formErrors and formErrors.fields.fullName
    }) }}

    <div class="govuk-button-group">
      {{ govukButton({ text: componentT(locale, localeBase, 'declaration', 'submitButton') }) }}
      <a class="govuk-link" href="{{ eprPackaging.manageYourRecyclingObligationsUrl }}">{{ componentT(locale, localeBase, 'declaration', 'cancelLink') }}</a>
    </div>
  </form>
{% endblock %}
