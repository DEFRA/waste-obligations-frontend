{% extends 'layouts/page.njk' %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% set pageTitle = t(locale, "compliance.certificate.pageTitle") %}
{% set headingText = t(locale, "compliance.certificate.heading") %}

{% block content %}
  {{ appHeading({
    text: headingText
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.description1", { year: year }) }}
      </p>

      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.description2") }}
      </p>

      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.description3") }}
      </p>

      {{ govukWarningText({
        text: t(locale, "compliance.certificate.warning"),
        iconFallbackText: t(locale, "compliance.common.warningIconFallback")
      }) }}

      <h2 class="govuk-heading-l">{{ t(locale, "compliance.certificate.howToTitle") }}</h2>

      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.howToDescription1") }}
      </p>

      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.howToDescription2", { year: year }) }}
      </p>

      <ul class="govuk-list govuk-list--bullet">
        <li>{{ t(locale, "compliance.certificate.bullet1") }}</li>
        <li>{{ t(locale, "compliance.certificate.bullet2") }}</li>
      </ul>

      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.regulatorPrefix") }}
        <a class="govuk-link" href="mailto:{{ regulatorEmail }}">{{ regulatorEmail }}</a>.
      </p>

      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.downloadDescription") }}
      </p>

      {% if showContinueToSubmit %}
      {{ govukButton({
        text: t(locale, "compliance.common.continue"),
        href: "/compliance/" + organisationId + "/certificate/submit?year=" + year
      }) }}
      {% else %}
      <p class="govuk-body">
        {{ t(locale, "compliance.certificate.alreadySubmittedLead", { year: year }) }}
      </p>
      {{ govukButton({
        text: t(locale, "compliance.certificate.viewSubmissionButton"),
        href: "/compliance/" + organisationId + "/certificate/success?year=" + year,
        classes: "govuk-button--secondary"
      }) }}
      {% endif %}
    </div>
  </div>
{% endblock %}

