{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "compliance-submit/csrf-field/macro.njk" import appCsrfField %}

{% set p = pageI18n(locale, 'prns.confirmReject') %}
{% set pageTitle = p.t('pageTitle', { type: prn.type }) %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-7">{{ p.t('heading', { type: prn.type }) }}</h1>

      {{ govukWarningText({
        text: p.t('warning'),
        iconFallbackText: t(locale, 'common.warningIconFallback')
      }) }}

      <form method="post" novalidate>
        {{ appCsrfField(csrfToken, csrfCookieName) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: p.t('confirmButton'),
            classes: "govuk-button--warning"
          }) }}
          {{ govukButton({
            text: p.t('goBackLink'),
            href: goBackHref,
            classes: "govuk-button--secondary"
          }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}
