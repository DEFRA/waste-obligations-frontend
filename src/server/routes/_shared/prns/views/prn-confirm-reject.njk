{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% set p = pageI18n(locale, 'prns.confirmReject') %}
{% set pageTitle = p.t('pageTitle', { type: prn.type }) %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-7">{{ p.t('heading', { type: prn.type }) }}</h1>

      {{ govukWarningText({
        text: p.t('warning'),
        iconFallbackText: t(locale, 'common.warningIconFallback')
      }) }}

      <div class="govuk-button-group">
        {# Shown with the confirmation screen. Rejecting the note is a later story,
           so this button does not submit a status change. #}
        {{ govukButton({
          text: p.t('confirmButton'),
          classes: "govuk-button--warning",
          type: "button",
          preventDoubleClick: false
        }) }}
        {{ govukButton({
          text: p.t('goBackLink'),
          href: goBackHref,
          classes: "govuk-button--secondary"
        }) }}
      </div>
    </div>
  </div>
{% endblock %}
