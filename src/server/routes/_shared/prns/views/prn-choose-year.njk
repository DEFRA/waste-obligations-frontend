{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "compliance-submit/csrf-field/macro.njk" import appCsrfField %}

{% set p = pageI18n(locale, 'prns.chooseYear') %}
{% set heading = p.t('heading', { type: prn.type }) %}
{% set title = p.t('pageTitle', { type: prn.type }) %}
{% set pageTitle = ('Error: ' + title) if formErrors else title %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if formErrors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: formErrors.summary
        }) }}
      {% endif %}

      <form method="post" novalidate>
        {{ appCsrfField(csrfToken, csrfCookieName) }}

        {{ govukRadios({
          idPrefix: "acceptYear",
          name: "acceptYear",
          classes: "govuk-radios--inline",
          fieldset: {
            legend: {
              text: heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: yearItems,
          errorMessage: { text: formErrors.message } if formErrors
        }) }}

        {{ govukButton({ text: p.t('continueButton') }) }}
      </form>
    </div>
  </div>
{% endblock %}
