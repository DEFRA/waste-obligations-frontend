{% extends 'layouts/page.njk' %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "compliance-submit/csrf-field/macro.njk" import appCsrfField %}

{% set p = pageI18n(locale, 'prns.list') %}
{% set pageTitle = ('Error: ' + p.t('pageHeading')) if formErrors else p.t('pageHeading') %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if formErrors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: formErrors.summary
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ p.t('pageHeading') }}</h1>
      <p class="govuk-body">{{ p.t('intro') }}</p>

      {% if prnsViewModel.rows.length %}
        {% set tableHead = [] %}
        {% for column in prnsViewModel.columns %}
          {% set tableHead = tableHead.concat([{ text: column.heading }]) %}
        {% endfor %}

        {% set tableRows = [] %}
        {% for row in prnsViewModel.rows %}
          {% set rowCells = [] %}
          {% for column in prnsViewModel.columns %}
            {% set rowCells = rowCells.concat([row[column.key]]) %}
          {% endfor %}
          {% set tableRows = tableRows.concat([rowCells]) %}
        {% endfor %}

        {% if prnsViewModel.showAcceptSelectedButton %}
        <form method="post" novalidate id="selected-prns">
          {{ appCsrfField(csrfToken, csrfCookieName) }}
        {% endif %}

        {{ govukTable({
          classes: prnsViewModel.classes,
          caption: p.t('tableCaption'),
          captionClasses: "govuk-table__caption--m govuk-visually-hidden",
          head: tableHead,
          rows: tableRows
        }) }}

        {% if total %}
          <p class="govuk-body">{{ p.t('resultsSummary', { from: prnsViewModel.resultsFrom, to: prnsViewModel.resultsTo, total: total }) }}</p>
        {% endif %}

        {% if prnsViewModel.showAcceptSelectedButton %}
          <div class="govuk-button-group">
            {{ govukButton({
              text: p.t('acceptSelectedButton')
            }) }}
          </div>
        </form>
        {% endif %}
      {% else %}
        <p class="govuk-body">{{ p.t('noPrnsFound') }}</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
