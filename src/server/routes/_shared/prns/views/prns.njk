{% extends 'layouts/page.njk' %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "compliance-submit/csrf-field/macro.njk" import appCsrfField %}
{% from "prns-sort-filter-form/macro.njk" import appPrnsSortFilterForm %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% set p = pageI18n(locale, 'prns.list') %}
{% set pageHeading = p.t('pageHeadingForYear', { year: year }) if year else p.t('pageHeading') %}
{% set pageTitle = ('Error: ' + pageHeading) if formErrors else pageHeading %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if formErrors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: formErrors.summary
        }) }}
      {% endif %}

      <h1 class="govuk-heading-xl">{{ pageHeading }}</h1>
      <p class="govuk-body">{{ p.t('intro') }}</p>
      <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">

      {{ appPrnsSortFilterForm({ sortFilter: prnsViewModel.sortFilter, locale: locale }) }}

      </div>

      <div class="govuk-grid-column-full">
      {% if prnsViewModel.rows.length or prnsViewModel.hasMaterialFilter %}
        {% set tableHead = [] %}
        {% for column in prnsViewModel.columns %}
          {% set tableHead = tableHead.concat([{ text: column.heading }]) %}
        {% endfor %}

        {% set tableRows = [] %}
        {% for row in prnsViewModel.rows %}
          {% set rowCells = [] %}
          {% for column in prnsViewModel.columns %}
            {% set rowCells = rowCells.concat([row[column.key]]) %}
          {% endfor %}
          {% set tableRows = tableRows.concat([rowCells]) %}
        {% endfor %}

        {% if prnsViewModel.showAcceptSelectedButton %}
        <form method="post" novalidate id="selected-prns">
          {{ appCsrfField(csrfToken, csrfCookieName) }}
        {% endif %}

        {{ govukTable({
          classes: prnsViewModel.classes,
          caption: p.t('tableCaption'),
          captionClasses: "govuk-table__caption--m govuk-visually-hidden",
          head: tableHead,
          rows: tableRows
        }) }}
        {% if total %}
          <p class="govuk-body app-prns-results-summary ">{{ p.t('resultsSummary', { from: prnsViewModel.resultsFrom, to: prnsViewModel.resultsTo, total: total }) }}</p>
        {% endif %}
        <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

        {% if prnsViewModel.pagination %}
          {{ govukPagination(prnsViewModel.pagination) }}
        {% endif %}

        {% if prnsViewModel.showAcceptSelectedButton %}
          <div class="govuk-button-group">
            {{ govukButton({
              text: p.t('acceptSelectedButton')
            }) }}
          </div>
        </form>
        {% endif %}
      {% else %}
        <p class="govuk-body">{{ p.t('noPrnsFound') }}</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
