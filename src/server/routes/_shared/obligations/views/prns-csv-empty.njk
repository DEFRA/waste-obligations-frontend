{% extends 'layouts/page.njk' %}

{% set p = pageI18n(locale, 'obligations.csvEmpty') %}
{% set pageTitle = p.t('title') %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>
      <p class="govuk-body">{{ p.t('none', { year: year }) }}</p>
      <p class="govuk-body">
        <a class="govuk-link govuk-link--no-visited-state" href="{{ backLink }}">{{ p.t('back') }}</a>
      </p>
    </div>
  </div>
{% endblock %}
