{% extends 'layouts/page.njk' %}

{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "certificate-obligations-table/macro.njk" import appCertificateObligationsTable %}
{% from "csoc-tile/macro.njk" import csocTile %}

{% set p = pageI18n(locale, localeBase) %}
{% set pageTitle = p.t('pageTitle') %}

{% block content %}
  <div class="app-obligations-home">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-0">
          {{ p.t('heading', { year: obligationYear }) }}
        </h1>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="app-obligations-home__intro">
          <div>
            <p class="govuk-body">
              {% if isProducer and organisationName %}
                {{ p.t('producerLabel') }} {{ organisationName }}<br>
              {% endif %}
              {% if not isProducer and complianceSchemeName %}
                {{ p.t('complianceSchemeLabel') }} {{ complianceSchemeName }}<br>
              {% endif %}
              {{ p.t('regulatorLabel') }} {{ regulatorName }}
            </p>
            <p class="govuk-body govuk-!-margin-bottom-0">
              {{ p.t('deadlineParagraph', { deadline: p.t('deadlineDateBold', { deadlineYear: deadlineYear }), year: obligationYear }) | safe }}
            </p>
          </div>

          {{ govukWarningText({
            text: p.t('enforcementWarning'),
            iconFallbackText: t(locale, 'common.warningIconFallback'),
            classes: "govuk-!-margin-bottom-0"
          }) }}

          <div class="govuk-inset-text govuk-!-margin-top-0 govuk-!-margin-bottom-0">
            <span class="govuk-body-m">{{ p.t('awaitingAcceptanceLabel') }}</span>
            <p class="govuk-body-l govuk-!-font-weight-bold govuk-!-margin-bottom-0">{{ awaitingAcceptanceCount }}</p>
            {% if acceptRejectPath %}
            <p class="govuk-body govuk-!-margin-bottom-0">
              <a class="govuk-link govuk-link--no-visited-state" href="{{ acceptRejectPath }}">{{ p.t('acceptRejectLink') }}</a>
            </p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <div class="app-obligations-home__section{% if showAlternativeHowToMeet %} meeting-obligations__alt-content{% endif %}">
          <h2 id="how-to-meet-heading" class="govuk-heading-l{% if not showAlternativeHowToMeet %} govuk-!-margin-bottom-0{% endif %}">{{ p.t('howToMeetHeading') }}</h2>
          {% if showAlternativeHowToMeet %}
          <p class="govuk-body">{{ p.t('altNotCalculatedIntro', { year: obligationYear }) }}</p>
          <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
            <li>{{ p.t('altSubmitDataBullet', { dataYear: dataYear }) }}</li>
            <li>{{ p.t('altRegulatorBullet') }}</li>
          </ul>
          <p class="govuk-body">{{ p.t('altUntilThen') }}</p>
          <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
            <li>{{ p.t('altAcquireBullet') }}</li>
            <li>{{ p.t('altAcceptBullet') }}</li>
          </ul>
          <p class="govuk-body">{{ p.t('altTableStatement') }}</p>
          {% else %}
          {% if notCalculated %}
            <div class="app-obligations-home__not-calculated">
            <p class="govuk-body">{{ p.t('notCalculatedIntro', { year: obligationYear }) }}</p>
            <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
              <li>{{ p.t('notCalculatedBullet1', { previousYear: previousYear }) }}</li>
              <li>{{ p.t('notCalculatedBullet2') }}</li>
            </ul>
            <p class="govuk-body">{{ p.t('untilThenIntro') }}</p>
            <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
              <li>{{ p.t('untilThenBullet1') }}</li>
              <li>{{ p.t('untilThenBullet2') }}</li>
            </ul>
            <p class="govuk-body">{{ p.t('tableBelowStatement') }}</p>

            {% if showDecemberWasteDetails %}
              {% set decemberWasteDetailsHtml %}
                <p class="govuk-body">{{ p.t('detailsIntro') }}</p>
                <p class="govuk-body govuk-!-margin-bottom-0">{{ p.t('detailsBeforeList1') }}</p>
                <p class="govuk-body">{{ p.t('detailsBeforeList2') }}</p>
                <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
                  <li>{{ p.t('detailsBullet1') }}</li>
                  <li>{{ p.t('detailsBullet2', { previousYear: previousYear, year: obligationYear }) }}</li>
                  <li>{{ p.t('detailsBullet3') }}</li>
                </ul>
                <p class="govuk-body">{{ p.t('detailsAfterList', { previousYear: previousYear, year: obligationYear }) }}</p>
                <p class="govuk-body">{{ p.t('detailsEnd') }}</p>
              {% endset %}
              {{ govukDetails({
                summaryText: p.t('detailsHeading'),
                html: decemberWasteDetailsHtml
              }) }}
            {% endif %}
            </div>
          {% else %}
            <p class="govuk-body govuk-!-margin-bottom-0">{{ p.t('howToMeetParagraph', { year: obligationYear }) }}</p>
          {% endif %}
          {% endif %}

          {{ appCertificateObligationsTable({
            locale: locale,
            i18n: p,
            tableRows: obligationsTableRows,
            caption: p.t('obligationsProgressCaption'),
            captionClasses: "govuk-table__caption--m",
            classes: "govuk-table app-obligations-table",
            ariaLabelledBy: "how-to-meet-heading"
          }) }}
        </div>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <div class="app-obligations-home__section">
          <h2 id="glass-heading" class="govuk-heading-l govuk-!-margin-bottom-0">{{ p.t('glassHeading') }}</h2>
          <p class="govuk-body govuk-!-margin-bottom-0">{{ p.t('glassDescription', { glassTarget: glassTarget }) }}</p>

          {{ appCertificateObligationsTable({
            locale: locale,
            i18n: p,
            tableRows: glassTableRows,
            caption: p.t('glassBreakdownCaption'),
            captionClasses: "govuk-table__caption--m",
            classes: "govuk-table app-obligations-table",
            ariaLabelledBy: "glass-heading"
          }) }}
        </div>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="app-obligations-home__section">
          <h2 class="govuk-heading-l govuk-!-margin-bottom-0">{{ p.t('whatToDoNextHeading') }}</h2>

          <div class="app-obligations-home__cards">

            <div class="app-obligations-card">
              <div class="app-obligations-card__body">
                <h3 class="govuk-heading-m">{{ p.t('reviewPrnsHeading', { year: obligationYear }) }}</h3>
                <p class="govuk-body">{{ p.t('reviewPrnsParagraph') }}</p>
                {% if acceptRejectPath %}
                <p class="govuk-body">
                  <a class="govuk-link govuk-link--no-visited-state" href="{{ acceptRejectPath }}">{{ p.t('acceptRejectYearLink', { year: obligationYear }) }}</a>
                </p>
                {% endif %}
                <p class="govuk-body">
                  <a class="govuk-link govuk-link--no-visited-state" href="#">{{ p.t('searchLink') }}</a>
                </p>
                <p class="govuk-body">
                  <a class="govuk-link govuk-link--no-visited-state" href="#">{{ p.t('downloadLink', { year: obligationYear }) }}</a>
                </p>
              </div>
            </div>

            {% if hasObligationData %}
            <div class="app-obligations-card">
              <div class="app-obligations-card__body">
                {% if submittedDeclaration %}
                  {{ csocTile({
                    type: "submitted",
                    heading: submittedDeclaration.heading,
                    paragraphPrefix: submittedDeclaration.paragraphPrefix,
                    linkText: p.t('certificate.submitted.buttonLabel' if isProducer else 'statement.submitted.buttonLabel'),
                    linkPath: submittedDeclaration.href,
                    showLink: showLink
                  }) }}
                {% elif cancelledSubmission %}
                  {{ csocTile({
                    type: "cancelled",
                    heading: cancelledSubmission.heading,
                    paragraphPrefix: cancelledSubmission.paragraph,
                    buttonLabel: cancelledSubmission.buttonLabel,
                    submitPath: submitCertificatePath,
                    showButton: showButton
                  }) }}
                {% elif cancelledMissedDeadline %}
                  {{ csocTile({
                    type: "missed",
                    heading: cancelledMissedDeadline.heading,
                    paragraphPrefix: cancelledMissedDeadline.paragraphPrefix,
                    paragraphSuffix: cancelledMissedDeadline.paragraphSuffix
                  }) }}
                {% elif missedDeadline %}
                  {{ csocTile({
                    type: "missed",
                    heading: missedDeadline.heading,
                    paragraphPrefix: missedDeadline.paragraphPrefix,
                    paragraphSuffix: missedDeadline.paragraphSuffix
                  }) }}
                {% elif submittedDeclaration == null %}
                  {{ csocTile({
                    type: "submit",
                    heading: p.t('certificate.submit.heading' if isProducer else 'statement.submit.heading'),
                    paragraphPrefix: p.t('certificate.submit.paragraph' if isProducer else 'statement.submit.paragraph', { year: obligationYear, futureYear: obligationYear + 1 }),
                    buttonLabel: p.t('certificate.submit.button' if isProducer else 'statement.submit.button'),
                    submitPath: submitCertificatePath,
                    showButton: showButton
                  }) }}
                {% endif %}
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
