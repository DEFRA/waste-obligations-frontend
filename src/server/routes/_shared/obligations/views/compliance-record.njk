{% extends 'layouts/page.njk' %}

{% set p = pageI18n(locale, 'obligations.complianceRecord') %}
{% set suffix = 'Producer' if isProducer else 'Scheme' %}
{% set pageTitle = p.t('title' + suffix, { year: year }) %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>
    </div>
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">{{ p.t('canShow' + suffix) }}</p>
      <p class="govuk-body">{{ p.t('cannotShow' + suffix, { year: year }) }}</p>
      <p class="govuk-body">
        {{ p.t('queriesWales' if isWales else 'queries', { regulatorName: regulatorName }) }}
        <a class="govuk-link" href="mailto:{{ regulatorEmail }}">{{ regulatorEmail }}</a>.
      </p>
      <p class="govuk-body">{{ p.t('viewPrns', { year: year }) }}</p>
    </div>
  </div>

  <div class="govuk-grid-row govuk-!-margin-top-6 govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <div class="app-obligations-card">
        <div class="app-obligations-card__body">
          <h2 class="govuk-heading-m">{{ p.t('prnsHeading', { year: year }) }}</h2>
          <p class="govuk-body">
            <a class="govuk-link govuk-link--no-visited-state" href="#">{{ p.t('viewLink', { year: year }) }}</a>
          </p>
          <p class="govuk-body">
            <a class="govuk-link govuk-link--no-visited-state" href="#">{{ p.t('downloadLink', { year: year }) }}</a>
          </p>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
