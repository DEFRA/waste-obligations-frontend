{#
  A small inline tag used to flash extra context onto a PRN/PERN
#}
{% macro appPrnFlashLabel(params) %}
  <span {%- if params.dataTestId %} data-testid="{{ params.dataTestId }}"{% endif %} class="flash-container flash-container--{{ params.backgroundColor | default('grey') }}">
    {{ params.labelText }}
  </span>
{% endmacro %}
