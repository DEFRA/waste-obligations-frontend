{% macro agencyLogo(agency, altText, isPdf) %}
    {% if isPdf %}
        <img class="prn-pdf-logo" alt="{{ altText }}" aria-hidden="true" focusable="false" src="{{ getAssetPath('src/client/images/logos/' + agency + '.png') }}">
    {% else %}
        <img alt="{{ altText }}" aria-hidden="true" focusable="false" src="{{ getAssetPath('src/client/images/logos/' + agency + '.svg') }}">
        <img class="prn-pdf-logo prn-pdf-only" alt="{{ altText }}" aria-hidden="true" focusable="false" src="{{ getAssetPath('src/client/images/logos/' + agency + '.png') }}">
    {% endif %}
{% endmacro %}

{% macro agencyLogos(params) %}
{% set altTexts = params.altTexts %}

<div class="prn-logos-container">
    <div class="prn-logos-items">
        {{ agencyLogo('ea', altTexts.ea, params.isPdf) }}
    </div>
    <div class="prn-logos-items">
        {{ agencyLogo('niea', altTexts.niea, params.isPdf) }}
    </div>
    <div class="prn-logos-items">
        {{ agencyLogo('sepa', altTexts.sepa, params.isPdf) }}
    </div>
    <div class="prn-logos-items">
        {{ agencyLogo('nrw', altTexts.nrw, params.isPdf) }}
    </div>
</div>
{% endmacro %}
