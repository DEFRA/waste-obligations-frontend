{% from "govuk/components/table/macro.njk" import govukTable %}

{% macro appCertificateObligationsTable(params) %}
  <div
    class="app-certificate-table-scroll"
    role="region"
    tabindex="0"
    {% if params.caption %}aria-label="{{ params.caption }}"{% endif %}
  >
    {{ govukTable({
      firstCellIsHeader: true,
      classes: params.classes or "app-certificate-table govuk-table--small-text-until-tablet govuk-!-margin-bottom-0",
      caption: params.caption,
      captionClasses: params.captionClasses,
      attributes: params.attributes,
      head: [
        { text: t(params.locale, params.headMaterialKey) },
        { text: t(params.locale, params.headObligationToMeetKey), format: "numeric" },
        { text: t(params.locale, params.headAwaitingKey), format: "numeric" },
        { text: t(params.locale, params.headAcceptedKey), format: "numeric" },
        { text: t(params.locale, params.headOutstandingKey), format: "numeric" },
        { text: t(params.locale, params.headStatusKey) }
      ],
      rows: params.tableRows
    }) }}
  </div>
{% endmacro %}
