{% from "certificate-obligations-table/macro.njk" import appCertificateObligationsTable %}

{% macro appComplianceSubmitObligationsTables(params) %}
  <section class="govuk-grid-row" aria-labelledby="{{ params.obligationsAriaLabelledBy or 'obligations-table-heading' }}">
    <div class="govuk-grid-column-full">
      {% if not params.obligationsAriaLabelledBy %}
        <h2 id="obligations-table-heading" class="govuk-heading-l">{{ componentT(params.locale, params.localeBase, 'obligationsTable', 'recyclingObligationsHeading') }}</h2>
      {% endif %}
      <p id="obligations-tonnes-note" class="govuk-body govuk-!-margin-bottom-4">{{ componentT(params.locale, params.localeBase, 'obligationsTable', 'tonnesNote') }}</p>

      {{ appCertificateObligationsTable({
        locale: params.locale,
        tableRows: params.obligationsTableRows,
        ariaLabelledBy: params.obligationsAriaLabelledBy or "obligations-table-heading",
        attributes: { "aria-describedby": "obligations-tonnes-note" },
        headMaterialKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableMaterial'),
        headObligationToMeetKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableObligationToMeet'),
        headAwaitingKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableAwaiting'),
        headAcceptedKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableAccepted'),
        headOutstandingKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableOutstanding'),
        headStatusKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableStatus')
      }) }}
    </div>
  </section>

  <section class="govuk-grid-row" aria-labelledby="glass-table-heading">
    <div class="govuk-grid-column-full">
      <h2 id="glass-table-heading" class="govuk-heading-m">{{ componentT(params.locale, params.localeBase, 'obligationsTable', 'glassHeading') }}</h2>

      {{ appCertificateObligationsTable({
        locale: params.locale,
        tableRows: params.glassTableRows,
        ariaLabelledBy: "glass-table-heading",
        attributes: { "aria-describedby": "obligations-tonnes-note" },
        headMaterialKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableMaterial'),
        headObligationToMeetKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableObligationToMeet'),
        headAwaitingKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableAwaiting'),
        headAcceptedKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableAccepted'),
        headOutstandingKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableOutstanding'),
        headStatusKey: componentLocaleKey(params.locale, params.localeBase, 'obligationsTable', 'tableStatus')
      }) }}
    </div>
  </section>
{% endmacro %}
