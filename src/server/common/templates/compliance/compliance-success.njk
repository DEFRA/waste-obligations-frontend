{% extends 'layouts/page.njk' %}

{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "link-opens-new-window/macro.njk" import appLinkOpensInNewWindow %}

{% set p = pageI18n(locale, localeBase) %}
{% set pageTitle = pageTitle or p.t('pageTitle') %}
{% set confirmationEmailInterpolation = confirmationEmailInterpolation or {} %}

{% block content %}
  <div class="govuk-grid-row app-compliance-success">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: p.t('panelTitle', { year: year }),
        classes: "govuk-!-margin-bottom-6"
      }) }}

      <section aria-labelledby="what-happens-next-heading">
        <h2 id="what-happens-next-heading" class="govuk-heading-l govuk-!-margin-bottom-4">{{ p.ct('success', 'whatHappensNext') }}</h2>

        <p class="govuk-body govuk-!-margin-bottom-6">
          {{ p.ct('success', 'confirmationEmail', confirmationEmailInterpolation) }}
        </p>

        <p class="govuk-body govuk-!-margin-bottom-6">
          {{ p.ct('success', documentLinkLeadKey) }}
          <a class="govuk-link" href="{{ eprPackaging.manageYourRecyclingObligationsUrl }}">{{ p.ct('success', 'manageObligationsLink') }}</a>
          {{ p.ct('success', documentLinkSuffixKey) }}
        </p>
      </section>

      <section aria-labelledby="regulator-may-ask">
        <p id="regulator-may-ask" class="govuk-body govuk-!-margin-bottom-4">
          {{ p.ct('success', 'regulatorMayAsk', { regulatorName: regulatorName }) }}
        </p>

        <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-6">
          <li>{{ p.ct('success', 'regulatorBullet1') }}</li>
          <li>{{ p.ct('success', 'regulatorBullet2') }}</li>
        </ul>
      </section>

      <section aria-labelledby="public-register-lead">
        <p id="public-register-lead" class="govuk-body govuk-!-margin-bottom-6">
          {{ p.ct('success', 'publicRegisterLead') }}
          {{ appLinkOpensInNewWindow({
            href: publicRegisterUrl,
            text: p.ct('success', 'publicRegisterLink'),
            hiddenText: t(locale, "common.opensInNewTab")
          }) }}.
        </p>
      </section>

      <section aria-labelledby="resubmit-lead">
        <p id="resubmit-lead" class="govuk-body govuk-!-margin-bottom-7">
          {{ p.ct('success', 'resubmitLead', { regulatorName: regulatorName }) }}
          <a class="govuk-link" href="mailto:{{ regulatorEmail }}">{{ regulatorEmail }}</a>.
        </p>
      </section>

      <nav aria-label="{{ p.ct('success', 'returnLink') }}" class="govuk-!-margin-bottom-7">
        {% block successActions %}{% endblock %}
      </nav>
    </div>
  </div>
{% endblock %}
