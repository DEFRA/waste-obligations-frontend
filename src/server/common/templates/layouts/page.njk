{% extends "govuk/template.njk" %}

{% set htmlLang = locale %}
{% set mainLang = locale %}

{# Import GOVUK components globally #}
{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}
{% from "link-opens-new-window/macro.njk" import appLinkOpensInNewWindow %}

{% set mainClasses = "app-main-wrapper" %}

{% block headIcons %}
  <link rel="icon" sizes="48x48" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.ico") }}">
  <link rel="icon" sizes="any" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.svg") }}" type="image/svg+xml" >
  <link rel="mask-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-mask.svg") }}" color="{{ themeColor }}">
  <link rel="apple-touch-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-180.png") }}">
  <link rel="manifest" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/manifest.json") }}">
{% endblock %}

{% block head %}
  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{% block header %}
  {# Legacy GOV.UK branding (govukRebrand global is false). #}
  {{ govukHeader({
    homepageUrl: "https://www.gov.uk/",
    classes: "epr-header",
    containerClasses: "govuk-width-container",
    serviceName: "Report packaging data",
    serviceUrl: eprPackaging.homeUrl,
    navigation: navigation,
    menuButtonText: t(locale, "compliance.common.nav.menu"),
    menuButtonLabel: t(locale, "compliance.common.nav.menuLabel"),
    useTudorCrown: false
  }) }}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle }} | Report packaging data
{% endblock %}

{% block beforeContent %}
  {% set phaseHtml %}
    {{ t(locale, "compliance.common.phaseBanner.lead") }}
    <a class="govuk-link" href="{{ eprPackaging.feedbackUrl }}" rel="noreferrer noopener" target="_blank">{{ t(locale, "compliance.common.phaseBanner.feedbackLink") }}</a>{{ t(locale, "compliance.common.phaseBanner.leadAfterLink") }}
  {% endset %}

  {{ govukPhaseBanner({
    tag: { text: t(locale, "compliance.common.phaseBanner.tag") },
    html: phaseHtml
  }) }}

  <div class="app-subheader">
    <nav class="app-language-switcher" aria-label="{{ t(locale, 'compliance.common.languageSwitcher.label') }}">
      {% if locale == 'cy' %}
        <a class="govuk-link govuk-link--no-visited-state" href="{{ languageSwitcher.en }}" lang="en">{{ t(locale, "compliance.common.languageSwitcher.english") }}</a>
      {% else %}
        <span lang="en">{{ t(locale, "compliance.common.languageSwitcher.english") }}</span>
      {% endif %}
      |
      {% if locale == 'cy' %}
        <span lang="cy">{{ t(locale, "compliance.common.languageSwitcher.welsh") }}</span>
      {% else %}
        <a class="govuk-link govuk-link--no-visited-state" href="{{ languageSwitcher.cy }}" lang="cy">{{ t(locale, "compliance.common.languageSwitcher.welsh") }}</a>
      {% endif %}
    </nav>

    {{ govukBackLink({
      href: eprPackaging.homeUrl,
      text: t(locale, "compliance.common.nav.home")
    }) }}
  </div>
{% endblock %}

{% block content %}{% endblock %}

{% block footer %}
  {% include "partials/epr-footer.njk" %}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
