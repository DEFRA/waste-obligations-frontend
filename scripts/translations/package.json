{
  "name": "waste-obligations-translations",
  "version": "0.0.0",
  "private": true,
  "description": "Local translation workbook tooling for waste-obligations-frontend",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
