    "brace-expansion": "5.0.9",
    "glob": "11.1.0",
    "nanoid": "3.3.17",
    "postcss": "8.5.24",
    "tmp": "0.2.7",
    "unzipper": "0.12.5",
    "uuid": "11.1.1"
  }
}
