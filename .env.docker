# WireMock-oriented defaults for local development.
#
# Host Node (npm run dev): config already defaults both APIs to http://localhost:9080
# when env vars are unset. Use this file to copy or merge into .env if you want the
# values explicit, or to override other keys in .env without editing that file by hand.
#
# Docker Compose: the app service already defaults to http://wiremock for both APIs.
# You can still pass: docker compose --env-file .env.docker up
# if you add compose-time variable overrides here later.

WASTE_ORGANISATIONS_API_BASE_URL=http://localhost:9080
WASTE_OBLIGATIONS_API_BASE_URL=http://localhost:9080
